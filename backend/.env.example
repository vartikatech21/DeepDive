# Neon PostgreSQL connection string (Neon dashboard -> Connect). pgvector is enabled automatically.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Groq API key (free): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# GitHub personal access token (read-only is enough): https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional tuning
# GITHUB_CONCURRENCY=8          parallel GitHub downloads
# GITHUB_REQUEST_DELAY=0.1      seconds of asyncio.sleep() after each GitHub request
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=8                       chunks retrieved per question
# CONTEXT_CHAR_BUDGET=22000     total prompt context size (Groq free tier has token-per-minute limits)
# MAX_FILE_KB=512               skip files bigger than this
# CORS_ORIGINS=*
